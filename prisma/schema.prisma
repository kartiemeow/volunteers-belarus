generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  VOLUNTEER
  ORGANIZER
  ADMIN
}

enum Category {
  SHELTER // приюты для животных
  ELDERLY // помощь пожилым
  PSO // поисково-спасательные отряды (поиск пропавших)
  URBAN // благоустройство городов
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN // волонтёр отменил участие
  DONE // волонтёр явился и выполнил заявку
  NO_SHOW // волонтёр записался, но не явился
}

enum NotificationType {
  APPLICATION_APPROVED // отклик одобрен
  PARTICIPATION_CONFIRMED // организация подтвердила выполнение
  RATING_RECEIVED // волонтёр оценил организацию
  ATTENDANCE_REMINDER // нужно отметить явку
  DATE_CHANGED // организация перенесла дату события
  PARTICIPATION_DECLINED // волонтёр отказался после переноса даты
}

enum OpportunityStatus {
  OPEN
  CLOSED
  COMPLETED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String
  role         Role      @default(VOLUNTEER)
  phone        String?
  city         String?
  emailVerified DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  volunteerProfile    VolunteerProfile?
  organizationProfile OrganizationProfile?

  newsPosts           NewsPost[]      @relation("NewsAuthor")
  notifications       Notification[]  @relation("UserNotifications")
}

model EmailVerification {
  id           String   @id @default(cuid())
  email        String   @unique
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  name         String
  passwordHash String
  role         Role
  phone        String?
  city         String?

}

model VolunteerProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio           String?
  skills        String[]
  interests     Category[]
  availability  String[] // например: ["Пн, утро", "Сб, весь день"]
  totalHours    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applications Application[]
  ratings      Rating[]
}

model OrganizationProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgName      String
  description  String?
  website      String?
  verified     Boolean  @default(false)
  category     Category[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  opportunities Opportunity[]
  ratings      Rating[]
}

model Opportunity {
  id            String             @id @default(cuid())
  title         String
  description   String
  category      Category
  city          String
  address       String?
  date          DateTime
  slots         Int                @default(1)
  filledSlots   Int                @default(0)
  requirements  String[]
  status        OpportunityStatus  @default(OPEN)
  contactInfo   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  organizerId  String
  organizer    OrganizationProfile @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  applications Application[]

  @@index([organizerId, createdAt, id])
  @@index([status, createdAt, id])
  @@index([createdAt, id])
  @@index([status, date])
}

model Application {
  id                 String            @id @default(cuid())
  status             ApplicationStatus @default(PENDING)
  message            String?
  hoursLogged        Int               @default(0)
  needsReconfirmation Boolean          @default(false) // организация перенесла дату — нужно повторное подтверждение
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  opportunityId  String
  opportunity    Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  volunteerId    String
  volunteer      VolunteerProfile  @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  rating         Rating?

  @@index([volunteerId, status])
  @@unique([opportunityId, volunteerId])
  @@index([volunteerId, status, createdAt, id])

}

model NewsPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User     @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  @@index([published, createdAt, id])

}

model Rating {
  id             String               @id @default(cuid())
  score          Int                  @default(5)
  comment        String?
  createdAt      DateTime             @default(now())

  volunteerId    String
  volunteer      VolunteerProfile     @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  organizationId String
  organization   OrganizationProfile  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  applicationId  String               @unique
  application    Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([volunteerId])

}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType @default(APPLICATION_APPROVED)
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  dedupeKey String? @unique

  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt, id])
  @@index([userId, read])
  @@index([userId, read, createdAt])
}

model RateLimit {
  key String @id
  count Int @default(0)
  expiresAt DateTime
}
