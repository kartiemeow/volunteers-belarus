# --- База данных (Neon PostgreSQL) ---
# Заполните URL своей Neon Postgres базы. Формат:
# postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
DATABASE_URL=""

# --- Auth.js секрет ---
# Сгенерируйте: npx auth secret   (или https://generate-secret.vercel.app/32)
AUTH_SECRET=""

# Для локальной разработки с NextAuth:
AUTH_TRUST_HOST="true"

# --- Проверка почты при регистрации ---
# Способ 1 (рекомендуется, полностью бесплатно, без телефона): SMTP вашего ящика.
#   Нужен обычный почтовый ящик (Yandex / Gmail) и «пароль приложения»:
#   - Яндекс: Почта -> Настройки -> Безопасность -> «Пароли приложений»
#     (нужна включённая 2FA). Хост smtp.yandex.ru, порт 465.
#   - Gmail: Google-аккаунт -> Безопасность -> 2-Step Verification ->
#     App passwords. Хост smtp.gmail.com, порт 465.
#   SMTP_USER = полный адрес ящика, SMTP_PASS = пароль приложения,
#   MAIL_FROM_EMAIL = тот же адрес ящика.
#   Чтобы письма приходили «от лица» вашей организации — укажите её имя в MAIL_FROM_NAME.
#   Тогда в письме будет: От: «Ваша организация» <адрес ящика>
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM_EMAIL=""
MAIL_FROM_NAME="Волонтёры Беларуси"

# Способ 2 (альтернатива): Brevo API (бесплатно 300 писем/день, но при регистрации
# требуется телефон). Используется, если SMTP_HOST не заполнен.
BREVO_API_KEY=""
#MAIL_FROM_EMAIL=""      # тоже используется Brevo-отправителем (см. выше)

# Секрет ежедневного задания Vercel (openssl rand -base64 32)
CRON_SECRET=""

# Разрешить демо-seed только для локальной тестовой базы
ALLOW_DEMO_SEED="false"
